# Environment variable baseline (placeholders only — no secrets)

# Supabase Auth (Stage 2+)
# Project URL from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable (public) key — not the service-role secret
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Auth setup notes (demo — same project for localhost + prod):
# 1. Enable Email provider in Authentication → Providers.
# 2. Turn OFF "Confirm email" so signup gets an immediate session everywhere.
# 3. Site URL: https://concile-me.vercel.app
# 4. Redirect URLs (both):
#      http://localhost:3000/**
#      https://concile-me.vercel.app/**
# 5. Password rules are enforced by the Supabase project policy.

# OpenAI (Stage 8+)
OPENAI_API_KEY=
