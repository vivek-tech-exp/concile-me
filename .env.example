# Environment variable baseline (placeholders only — no secrets)

# Supabase Auth (Stage 2+)
# Project URL from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable (public) key — not the service-role secret
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Auth setup notes:
# 1. Enable Email provider in Supabase Authentication → Providers.
# 2. Add http://localhost:3000/** to Authentication → URL Configuration → Redirect URLs.
# 3. Set Site URL to http://localhost:3000 for local development.
# 4. If email confirmation is enabled, update the Confirm signup template link to:
#    {{ .SiteURL }}/auth/confirm?token_hash={{ .TokenHash }}&type=email
# 5. Password rules are enforced by the Supabase project policy (do not duplicate in the app).

# OpenAI (Stage 8+)
OPENAI_API_KEY=
