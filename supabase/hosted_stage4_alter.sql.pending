-- Targeted ALTER statements for an existing Stage 3 hosted Supabase project.
-- DO NOT apply without explicit approval. Never reset or drop the linked database.
-- Local development continues to use a full apply of supabase/schema.sql via db:reset.

BEGIN;

-- import_batches counts
ALTER TABLE public.import_batches
  ADD COLUMN IF NOT EXISTS orders_row_count integer NOT NULL DEFAULT 0,
  ADD COLUMN IF NOT EXISTS payments_row_count integer NOT NULL DEFAULT 0,
  ADD COLUMN IF NOT EXISTS warning_count integer NOT NULL DEFAULT 0;

ALTER TABLE public.import_batches
  DROP CONSTRAINT IF EXISTS import_batches_counts_nonnegative;

ALTER TABLE public.import_batches
  ADD CONSTRAINT import_batches_counts_nonnegative
  CHECK (
    orders_row_count >= 0
    AND payments_row_count >= 0
    AND warning_count >= 0
  );

-- order_records: rename money columns and expand source fields
ALTER TABLE public.order_records
  RENAME COLUMN original_amount TO original_net_amount;

ALTER TABLE public.order_records
  RENAME COLUMN amount_minor TO net_amount_minor;

ALTER TABLE public.order_records
  DROP CONSTRAINT IF EXISTS order_records_amount_safe_check;

ALTER TABLE public.order_records
  ADD COLUMN IF NOT EXISTS original_customer_email text,
  ADD COLUMN IF NOT EXISTS original_gross_amount text,
  ADD COLUMN IF NOT EXISTS gross_amount_minor bigint,
  ADD COLUMN IF NOT EXISTS original_discount text,
  ADD COLUMN IF NOT EXISTS discount_minor bigint;

-- Backfill required money columns for any pre-Stage-4 rows (development only).
UPDATE public.order_records
SET
  original_gross_amount = COALESCE(original_gross_amount, original_net_amount),
  gross_amount_minor = COALESCE(gross_amount_minor, net_amount_minor)
WHERE original_gross_amount IS NULL OR gross_amount_minor IS NULL;

ALTER TABLE public.order_records
  ALTER COLUMN original_gross_amount SET NOT NULL,
  ALTER COLUMN gross_amount_minor SET NOT NULL;

ALTER TABLE public.order_records
  ADD CONSTRAINT order_records_gross_safe_check
    CHECK (public.is_safe_js_bigint(gross_amount_minor)),
  ADD CONSTRAINT order_records_discount_safe_check
    CHECK (
      discount_minor IS NULL
      OR public.is_safe_js_bigint(discount_minor)
    ),
  ADD CONSTRAINT order_records_net_safe_check
    CHECK (public.is_safe_js_bigint(net_amount_minor));

ALTER TABLE public.order_records
  ADD COLUMN IF NOT EXISTS order_timestamp timestamp without time zone;

UPDATE public.order_records
SET order_timestamp = COALESCE(order_timestamp, order_date::timestamp)
WHERE order_timestamp IS NULL AND order_date IS NOT NULL;

-- Development projects with incomplete timestamps must be cleaned before NOT NULL.
-- ALTER TABLE public.order_records ALTER COLUMN order_timestamp SET NOT NULL;
ALTER TABLE public.order_records
  DROP COLUMN IF EXISTS order_date;

-- payment_records
ALTER TABLE public.payment_records
  ADD COLUMN IF NOT EXISTS original_fee text,
  ADD COLUMN IF NOT EXISTS fee_minor bigint,
  ADD COLUMN IF NOT EXISTS original_net_settled text,
  ADD COLUMN IF NOT EXISTS net_settled_minor bigint,
  ADD COLUMN IF NOT EXISTS processed_at timestamp without time zone;

UPDATE public.payment_records
SET
  original_fee = COALESCE(original_fee, '0'),
  fee_minor = COALESCE(fee_minor, 0),
  original_net_settled = COALESCE(original_net_settled, original_amount),
  net_settled_minor = COALESCE(net_settled_minor, amount_minor),
  processed_at = COALESCE(processed_at, transaction_date::timestamp)
WHERE original_fee IS NULL
   OR fee_minor IS NULL
   OR original_net_settled IS NULL
   OR net_settled_minor IS NULL;

ALTER TABLE public.payment_records
  ALTER COLUMN original_fee SET NOT NULL,
  ALTER COLUMN fee_minor SET NOT NULL,
  ALTER COLUMN original_net_settled SET NOT NULL,
  ALTER COLUMN net_settled_minor SET NOT NULL;

ALTER TABLE public.payment_records
  ADD CONSTRAINT payment_records_fee_safe_check
    CHECK (public.is_safe_js_bigint(fee_minor)),
  ADD CONSTRAINT payment_records_net_settled_safe_check
    CHECK (public.is_safe_js_bigint(net_settled_minor));

ALTER TABLE public.payment_records
  DROP COLUMN IF EXISTS transaction_date;

-- Recreate create_import_batch from supabase/schema.sql after this ALTER.
-- (Copy the full CREATE OR REPLACE FUNCTION public.create_import_batch ... block.)

COMMIT;
